{
    "name": "evelode/tiktok-api-php",
    "description": "TikTok Scraper API for PHP \u2014 typed response models, video, profiles, comments and search",
    "homepage": "https://github.com/evelode/tiktok-api-php",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "sergeykomlev/lazyjsonmapper": "^2.0.0",
        "guzzlehttp/guzzle": "^7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Evelode",
            "email": "contact@evelode.com",
            "homepage": "https://evelode.com",
            "role": "Developer"
        }
    ],
    "suggest": {
        "ext-curl": "Required for CURL handler support in requests"
    },
    "autoload": {
        "psr-4": {
            "TikTokRESTAPI\\": "src/"
        }
    },
    "keywords": [
        "tiktok",
        "tiktok-api",
        "tiktok-scraper",
        "scraper-api",
        "jsonscraper",
        "sdk"
    ],
    "scripts": {
        "test": "php tests/smoke.php"
    }
}
